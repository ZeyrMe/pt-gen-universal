{
  "name": "pt-gen-universal",
  "version": "2.0.0",
  "description": "PT-Gen on server and serverless platforms",
  "packageManager": "pnpm@9.15.9",
  "main": "src/adapters/node.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/adapters/node.ts",
    "dev:cf": "wrangler dev",
    "dev:bun": "bun --hot src/adapters/bun.ts",
    "dev:node": "tsx watch src/adapters/node.ts",
    "generate:homepage": "node scripts/generate-homepage.mjs",
    "check:homepage": "node scripts/generate-homepage.mjs --check",
    "check:runtime-entries": "pnpm exec tsx scripts/smoke-runtime-entries.mjs",
    "check:types": "pnpm exec tsc -p tsconfig.edge.json && pnpm exec tsc -p tsconfig.node.json && pnpm exec tsc -p tsconfig.test.json",
    "start": "pnpm run start:node",
    "build:cf": "wrangler deploy",
    "build:vercel": "pnpm run check:homepage && pnpm run check:types",
    "build:netlify": "pnpm run check:homepage && pnpm run check:types",
    "build:edgeone": "pnpm run check:homepage && pnpm run check:types",
    "start:bun": "bun src/adapters/bun.ts",
    "start:node": "tsx src/adapters/node.ts",
    "build": "wrangler build",
    "deploy": "wrangler deploy",
    "format": "prettier --write \"**/*.{ts,js,json,jsonc,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,jsonc,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run format:check && pnpm run check:homepage && pnpm run check:runtime-entries && pnpm run check:worker && pnpm run check:types && pnpm run test:coverage && pnpm run build",
    "check:worker": "node scripts/smoke-worker.mjs"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9 <10"
  },
  "author": "YunFeng <YunFengZero@outlook.com>",
  "forkedFrom": "github.com/Rhilip/pt-gen-cfworker",
  "contributors": [
    "Rhilip <rhilipruan@gmail.com>"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@netlify/blobs": "^10.7.13",
    "@upstash/redis": "^1.37.0",
    "cheerio": "^1.1.2",
    "hono": "^4.13.13",
    "html2bbcode": "^1.2.6",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "0.27.7",
    "miniflare": "4.20260401.0",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "wrangler": "^4.59.1"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "entities": "^7.0.0",
    "undici": "^7.30.0"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy": "^3.2.2",
      "entities": "^7.0.0",
      "undici": "^7.30.0"
    }
  }
}
